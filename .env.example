# Postgres
DATABASE_URL=postgresql+asyncpg://bdhost:bdhost@localhost:5432/bdhost

# Redis
REDIS_URL=redis://localhost:6379/0

# Cloudflare R2 Object Storage
R2_ENDPOINT_URL=https://<cloudflare_account_id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=your-cloudflare-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-cloudflare-r2-secret-access-key
R2_BUCKET=bdappshub-apps
R2_REGION=auto

# Auth
JWT_SECRET=change-me-to-a-secure-random-secret-key-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# App
BASE_DOMAIN=bdappshub.com
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,https://app.bdappshub.com

# Cloudflare DNS & Automation
CLOUDFLARE_API_TOKEN=your-cloudflare-api-token
CLOUDFLARE_ZONE_ID=your-cloudflare-zone-id
CLOUDFLARE_ACCOUNT_ID=your-cloudflare-account-id
APP_RUNTIME_IP=127.0.0.1

